{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:*"],
      "Resource": [
        "arn:aws:s3:::tolink-dev-raw",
        "arn:aws:s3:::tolink-dev-raw/*",
        "arn:aws:s3:::tolink-dev-docs",
        "arn:aws:s3:::tolink-dev-docs/*",
        "arn:aws:s3:::tolink-dev-public",
        "arn:aws:s3:::tolink-dev-public/*"
      ]
    }
  ]
}
