# 非敏感测试配置，随 dev 部署自动同步。密钥位于服务器 secrets/rag.env。
APP_ENV=test
APP_NAME=toLink-Rag-Test
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=["http://100.86.10.52:18080"]

DB_HOST=tolink-test-mysql
DB_PORT=3306
DB_NAME=tolink_rag_test
DB_USER=tolink_test

REDIS_HOST=tolink-test-redis
REDIS_PORT=6379
REDIS_DB=0

QDRANT_HOST=tolink-test-qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=tolink_test_collection
QDRANT_BM25_COLLECTION=tolink_test_bm25
CHUNK_INDEX_COLLECTION_PREFIX=test_kb_bucket

MANTICORE_HOST=tolink-test-manticore
MANTICORE_PORT=9306
MANTICORE_BM25_TABLE_PREFIX=test_bm25_ds_v2

STORAGE_TYPE=minio
MINIO_ENDPOINT=host.docker.internal:9000
MINIO_ACCESS_KEY=tolinktest
MINIO_RAW_BUCKET=tolink-test-raw
MINIO_PRIVATE_BUCKET=tolink-test-docs
MINIO_PUBLIC_BUCKET=tolink-test-public
MINIO_USE_SSL=false
MINIO_PUBLIC_ENDPOINT=https://linkrag.cn

MQ_VENDOR=kafka
KAFKA_BOOTSTRAP_SERVERS=tolink-test-kafka:29092
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=tolink_test
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
INIT_KAFKA_TOPICS_ON_STARTUP=true
PARSE_TASK_TOPIC=tolink.rag.parse_task
USAGE_REPORT_TOPIC=tolink.rag.usage_report
CHAT_TURN_TOPIC=tolink.rag.chat_turn
DOCUMENT_DELETE_TOPIC=tolink.rag.document_delete
REPLICATION_FACTOR=1
MIN_INSYNC_REPLICAS=1

LOG_SERVICE_NAME=tolink-rag-test
RECALL_SESSION_AUTH_ENABLED=true
RECALL_SESSION_JWT_ISSUER=tolink-java-test
RECALL_SESSION_JWT_AUDIENCE=tolink-rag-frontend
RECALL_SESSION_JWT_SCOPE=recall:stream
