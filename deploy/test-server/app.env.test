# Java 非敏感 dev 隔离覆盖配置，随 dev 部署自动同步。密钥位于服务器 secrets/app.env。
SPRING_DATASOURCE_URL=jdbc:mysql://tolink-test-mysql:3306/tolink_rag_test?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=tolink_test

SPRING_REDIS_HOST=tolink-test-redis
SPRING_REDIS_PORT=6379
SPRING_REDIS_DATABASE=0

SPRING_KAFKA_BOOTSTRAP_SERVERS=tolink-test-kafka:29092
SPRING_KAFKA_PROPERTIES_SECURITY_PROTOCOL=SASL_PLAINTEXT
SPRING_KAFKA_PROPERTIES_SASL_MECHANISM=PLAIN

TOLINK_MQ_VENDOR=kafka
TOLINK_MQ_KAFKA_AUTO_CREATE_TOPICS=true
TOLINK_MQ_KAFKA_TOPIC_PARTITIONS=1
TOLINK_MQ_KAFKA_TOPIC_REPLICAS=1

TOLINK_OSS_SERVICE_TYPE=minio
TOLINK_OSS_PUBLIC_BASE_URL=/tolink-public
TOLINK_OSS_MINIO_ENDPOINT=http://host.docker.internal:9000
TOLINK_OSS_MINIO_RAW_BUCKET_NAME=tolink-test-raw
TOLINK_OSS_MINIO_PRIVATE_BUCKET_NAME=tolink-test-docs
TOLINK_OSS_MINIO_PUBLIC_BUCKET_NAME=tolink-test-public
TOLINK_OSS_MINIO_ACCESS_KEY=tolinktest

TOLINK_RECALL_PYTHON_BASE_URL=http://tolink-test-rag:8000
TOLINK_DOCUMENT_FILE_INTERNAL_BASE_URL=http://tolink-test-service:8080
TOLINK_RECALL_SESSION_STREAM_BASE_URL=http://100.86.10.52:18000
OBSERVABILITY_LOKI_BASE_URL=http://tolink-test-loki:3100
